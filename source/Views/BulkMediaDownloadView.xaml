<UserControl x:Class="BackgroundChanger.Views.BulkMediaDownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:filtercontrols="clr-namespace:BackgroundChangerPlugin.Controls"
             xmlns:playnitecontrols="clr-namespace:CommonPluginsControls.PlayniteControls"
             mc:Ignorable="d"
             Background="{DynamicResource WindowBackgourndBrush}"
             Height="720" Width="780">

    <Border Style="{DynamicResource TopSeparatorBorder}">
        <Grid>
            <DockPanel LastChildFill="True" Margin="20">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="{DynamicResource LOCBcBulkDownloadTitle}"
                               Style="{DynamicResource BaseTextBlockStyle}"
                               FontSize="{DynamicResource FontSizeLarge}"
                               FontWeight="SemiBold" />
                    <Border Height="2"
                            Background="{DynamicResource GlyphBrush}"
                            HorizontalAlignment="Stretch"
                            Margin="0,8,0,0" />
                </StackPanel>

                <Border BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource NormalBorderBrush}"
                        Padding="0,10,0,0"
                        Margin="0,10,0,0"
                        DockPanel.Dock="Bottom">
                    <Grid>
                        <Button Name="PART_BtSaveOptions"
                                HorizontalAlignment="Left"
                                Content="{DynamicResource LOCBcBulkSaveOptions}"
                                Style="{StaticResource SecondaryButton}"
                                Click="PART_BtSaveOptions_Click" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Name="PART_BtCancel"
                                    Content="{DynamicResource LOCCancelLabel}"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="PART_BtCancel_Click" />
                            <Button Name="PART_BtDownload"
                                    Content="{DynamicResource LOCDownloadLabel}"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="10,0,0,0"
                                    Click="PART_BtDownload_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCCommonGameSource}"
                                           Style="{StaticResource SectionHeaderText}" />
                                <UniformGrid Columns="3" Rows="1">
                                    <RadioButton Name="PART_GameSourceAll"
                                                 Style="{StaticResource ModernRadio}"
                                                 GroupName="BulkGameSource"
                                                 Content="{DynamicResource LOCQuickFilterAllGames}" />
                                    <RadioButton Name="PART_GameSourceFiltered"
                                                 Style="{StaticResource ModernRadio}"
                                                 GroupName="BulkGameSource"
                                                 Content="{DynamicResource LOCMetaGameSourceFiltered}" />
                                    <RadioButton Name="PART_GameSourceSelected"
                                                 Style="{StaticResource ModernRadio}"
                                                 GroupName="BulkGameSource"
                                                 Content="{DynamicResource LOCMetaGameSourceSelected}" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCCommonInstallationStatus}"
                                           Style="{StaticResource SectionHeaderText}" />
                                <UniformGrid Columns="3" Rows="1">
                                    <RadioButton Name="PART_InstallInstalled"
                                                 Style="{StaticResource ModernRadio}"
                                                 GroupName="BulkInstallFilter"
                                                 Checked="GameFilterChanged"
                                                 Unchecked="GameFilterChanged"
                                                 Content="{DynamicResource LOCGameIsGameInstalledTitle}" />
                                    <RadioButton Name="PART_InstallNotInstalled"
                                                 Style="{StaticResource ModernRadio}"
                                                 GroupName="BulkInstallFilter"
                                                 Checked="GameFilterChanged"
                                                 Unchecked="GameFilterChanged"
                                                 Content="{DynamicResource LOCGameIsUnInstalledTitle}" />
                                    <RadioButton Name="PART_InstallFavorite"
                                                 Style="{StaticResource ModernRadio}"
                                                 GroupName="BulkInstallFilter"
                                                 Checked="GameFilterChanged"
                                                 Unchecked="GameFilterChanged"
                                                 Content="{DynamicResource LOCQuickFilterFavorites}" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCCommonTimeFilters}"
                                           Style="{StaticResource SectionHeaderText}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Name="PART_TimeOldData"
                                                 Grid.Column="0"
                                                 Style="{StaticResource ModernRadio}"
                                                 GroupName="BulkTimeFilter"
                                                 Checked="GameFilterChanged"
                                                 Unchecked="GameFilterChanged"
                                                 Content="{DynamicResource LOCCommonOldData}" />
                                    <RadioButton Name="PART_TimeRecentlyPlayed"
                                                 Grid.Column="1"
                                                 Style="{StaticResource ModernRadio}"
                                                 GroupName="BulkTimeFilter"
                                                 Checked="GameFilterChanged"
                                                 Unchecked="GameFilterChanged"
                                                 Content="{DynamicResource LOCQuickFilterRecentlyPlayed}" />
                                    <RadioButton Name="PART_TimeRecentlyAdded"
                                                 Grid.Column="2"
                                                 Style="{StaticResource ModernRadio}"
                                                 GroupName="BulkTimeFilter"
                                                 Checked="GameFilterChanged"
                                                 Unchecked="GameFilterChanged"
                                                 Content="{DynamicResource LOCCommonRecentlyAdded}" />
                                    <Border Grid.Column="3"
                                            Background="{DynamicResource ControlBackgroundBrush}"
                                            BorderBrush="{DynamicResource NormalBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Padding="12,6"
                                            Margin="16,0,0,0">
                                        <StackPanel Name="PART_MonthSelect"
                                                    Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource LOCCommonSince}"
                                                       Style="{DynamicResource BaseTextBlockStyle}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <playnitecontrols:NumericBox x:Name="PART_GameFilterMonths"
                                                                         MinWidth="50"
                                                                         Height="24"
                                                                         MinLongValue="1"
                                                                         HorizontalContentAlignment="Center"
                                                                         VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource LOCCommonMonthsLabel}"
                                                       Style="{DynamicResource BaseTextBlockStyle}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCBcBulkSources}"
                                           Style="{StaticResource SectionHeaderText}" />
                                <UniformGrid Columns="2" Rows="1">
                                    <CheckBox Name="PART_EnableSteam"
                                              Style="{StaticResource ModernCheckBox}"
                                              Content="{DynamicResource LOCBcBulkSourceSteam}"
                                              Checked="OptionsChanged"
                                              Unchecked="OptionsChanged" />
                                    <CheckBox Name="PART_EnableSteamGridDb"
                                              Style="{StaticResource ModernCheckBox}"
                                              Content="{DynamicResource LOCBcBulkSourceSteamGridDb}"
                                              Checked="SteamGridDbSourceChanged"
                                              Unchecked="SteamGridDbSourceChanged" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCBcBulkMediaKinds}"
                                           Style="{StaticResource SectionHeaderText}" />
                                <UniformGrid Columns="3" Rows="1">
                                    <CheckBox Name="PART_EnableBackground"
                                              Style="{StaticResource ModernCheckBox}"
                                              Content="{DynamicResource LOCGameBackgroundTitle}"
                                              Checked="OptionsChanged"
                                              Unchecked="OptionsChanged" />
                                    <CheckBox Name="PART_EnableCover"
                                              Style="{StaticResource ModernCheckBox}"
                                              Content="{DynamicResource LOCGameCoverTitle}"
                                              Checked="OptionsChanged"
                                              Unchecked="OptionsChanged" />
                                    <CheckBox Name="PART_EnableIcon"
                                              Style="{StaticResource ModernCheckBox}"
                                              Content="{DynamicResource LOCGameIconTitle}"
                                              Checked="OptionsChanged"
                                              Unchecked="OptionsChanged" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCCommonAdditionalOptions}"
                                           Style="{StaticResource SectionHeaderText}" />

                                <CheckBox Name="PART_OnlyGamesWithoutPluginData"
                                          Style="{StaticResource ModernCheckBox}"
                                          Content="{DynamicResource LOCBcBulkOnlyGamesWithoutData}"
                                          Margin="0,0,0,8" />

                                <CheckBox Name="PART_OnlyMissing"
                                          Style="{StaticResource ModernCheckBox}"
                                          Content="{DynamicResource LOCBcBulkOnlyMissing}"
                                          Margin="0,0,0,8" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource LOCBcBulkQuantity}"
                                                   Style="{DynamicResource BaseTextBlockStyle}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <playnitecontrols:NumericBox x:Name="PART_Quantity"
                                                                     MinWidth="60"
                                                                     Height="24"
                                                                     MinLongValue="1"
                                                                     MaxLongValue="500"
                                                                     HorizontalContentAlignment="Center"
                                                                     VerticalAlignment="Center" />
                                    </StackPanel>
                                    <CheckBox Name="PART_DownloadAll"
                                              Grid.Column="2"
                                              Style="{StaticResource ModernCheckBox}"
                                              Content="{DynamicResource LOCBcBulkDownloadAll}"
                                              Checked="DownloadAllChanged"
                                              Unchecked="DownloadAllChanged"
                                              VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource LOCBcBulkFuzzyThreshold}"
                                               Style="{DynamicResource BaseTextBlockStyle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <playnitecontrols:NumericBox x:Name="PART_FuzzyThreshold"
                                                                     MinWidth="60"
                                                                     Height="24"
                                                                     MinLongValue="0"
                                                                     MaxLongValue="100"
                                                                     HorizontalContentAlignment="Center" />
                                        <TextBlock Text="%"
                                                   Style="{DynamicResource BaseTextBlockStyle}"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0" />
                                    </StackPanel>
                                </Grid>

                                <CheckBox Name="PART_PromptOnLowFuzzy"
                                          Style="{StaticResource ModernCheckBox}"
                                          Content="{DynamicResource LOCBcBulkPromptLowFuzzy}"
                                          Margin="0,0,0,8" />

                                <CheckBox Name="PART_AllowAnimated"
                                          Style="{StaticResource ModernCheckBox}"
                                          Content="{DynamicResource LOCBcBulkAllowAnimated}"
                                          Margin="0,0,0,8"
                                          Checked="AllowAnimatedChanged"
                                          Unchecked="AllowAnimatedChanged" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource LOCBcBulkPickMode}"
                                               Style="{DynamicResource BaseTextBlockStyle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <ComboBox Name="PART_PickMode"
                                              Grid.Column="1"
                                              MinWidth="200"
                                              HorizontalAlignment="Left" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Name="PART_SgdbFiltersSection" Style="{StaticResource SectionBorder}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCBcBulkSteamGridFilters}"
                                           Style="{StaticResource SectionHeaderText}" />
                                <TabControl Name="PART_FilterTabs" Margin="0,4,0,0">
                                    <TabItem Header="{DynamicResource LOCGameBackgroundTitle}">
                                        <StackPanel Margin="0,10,0,0">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource LOCCommonDimensions}"
                                                           Style="{DynamicResource BaseTextBlockStyle}"
                                                           VerticalAlignment="Center" />
                                                <filtercontrols:CheckListFilterBox Grid.Column="1"
                                                                                   x:Name="PART_BgDimensions"
                                                                                   UseShortSummary="True" />
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource LOCCommonStyles}"
                                                           Style="{DynamicResource BaseTextBlockStyle}"
                                                           VerticalAlignment="Center" />
                                                <filtercontrols:CheckListFilterBox Grid.Column="1" x:Name="PART_BgStyles" />
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource LOCCommonTypes}"
                                                           Style="{DynamicResource BaseTextBlockStyle}"
                                                           VerticalAlignment="Center" />
                                                <filtercontrols:CheckListFilterBox Grid.Column="1" x:Name="PART_BgTypes" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource LOCTagsLabel}"
                                                           Style="{DynamicResource BaseTextBlockStyle}"
                                                           VerticalAlignment="Center" />
                                                <filtercontrols:CheckListFilterBox Grid.Column="1" x:Name="PART_BgTags" />
                                            </Grid>
                                        </StackPanel>
                                    </TabItem>
                                    <TabItem Header="{DynamicResource LOCGameCoverTitle}">
                                        <StackPanel Margin="0,10,0,0">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource LOCCommonDimensions}"
                                                           Style="{DynamicResource BaseTextBlockStyle}"
                                                           VerticalAlignment="Center" />
                                                <filtercontrols:CheckListFilterBox Grid.Column="1"
                                                                                   x:Name="PART_CoverDimensions"
                                                                                   UseShortSummary="True" />
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource LOCCommonStyles}"
                                                           Style="{DynamicResource BaseTextBlockStyle}"
                                                           VerticalAlignment="Center" />
                                                <filtercontrols:CheckListFilterBox Grid.Column="1" x:Name="PART_CoverStyles" />
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource LOCCommonTypes}"
                                                           Style="{DynamicResource BaseTextBlockStyle}"
                                                           VerticalAlignment="Center" />
                                                <filtercontrols:CheckListFilterBox Grid.Column="1" x:Name="PART_CoverTypes" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource LOCTagsLabel}"
                                                           Style="{DynamicResource BaseTextBlockStyle}"
                                                           VerticalAlignment="Center" />
                                                <filtercontrols:CheckListFilterBox Grid.Column="1" x:Name="PART_CoverTags" />
                                            </Grid>
                                        </StackPanel>
                                    </TabItem>
                                    <TabItem Header="{DynamicResource LOCGameIconTitle}">
                                        <StackPanel Margin="0,10,0,0">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource LOCCommonDimensions}"
                                                           Style="{DynamicResource BaseTextBlockStyle}"
                                                           VerticalAlignment="Center" />
                                                <filtercontrols:CheckListFilterBox Grid.Column="1"
                                                                                   x:Name="PART_IconDimensions"
                                                                                   UseShortSummary="True" />
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource LOCCommonStyles}"
                                                           Style="{DynamicResource BaseTextBlockStyle}"
                                                           VerticalAlignment="Center" />
                                                <filtercontrols:CheckListFilterBox Grid.Column="1" x:Name="PART_IconStyles" />
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource LOCCommonTypes}"
                                                           Style="{DynamicResource BaseTextBlockStyle}"
                                                           VerticalAlignment="Center" />
                                                <filtercontrols:CheckListFilterBox Grid.Column="1" x:Name="PART_IconTypes" />
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource LOCTagsLabel}"
                                                           Style="{DynamicResource BaseTextBlockStyle}"
                                                           VerticalAlignment="Center" />
                                                <filtercontrols:CheckListFilterBox Grid.Column="1" x:Name="PART_IconTags" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource LOCBcSteamGridDbMimes}"
                                                           Style="{DynamicResource BaseTextBlockStyle}"
                                                           VerticalAlignment="Center" />
                                                <filtercontrols:CheckListFilterBox Grid.Column="1" x:Name="PART_IconMimes" />
                                            </Grid>
                                        </StackPanel>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
