<UserControl x:Class="BackgroundChanger.Views.SteamSelectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:playnitecontrols="clr-namespace:CommonPluginsControls.PlayniteControls"
             xmlns:converters="clr-namespace:CommonPlayniteShared.Converters"
             xmlns:controls1="clr-namespace:CommonPluginsShared.Controls"
             xmlns:controls2="clr-namespace:CommonPluginsControls.Controls"
             mc:Ignorable="d"
             Height="700" Width="1100">

    <UserControl.Resources>
        <converters:StringNullOrEmptyToBoolConverter x:Key="StringNullOrEmptyToBoolConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter" />
    </UserControl.Resources>

    <DockPanel Margin="10" LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Separator Margin="0,0,0,10" />

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>

                <playnitecontrols:SearchBox Grid.Column="0" x:Name="SearchElement" KeyUp="SearchElement_KeyUp" />
                <Button Name="PART_BtSearch" Grid.Column="2" Content="{DynamicResource LOCSearchLabel}" Click="PART_BtSearch_Click"
                        IsEnabled="{Binding ElementName=SearchElement, Path=Text, Converter={StaticResource StringNullOrEmptyToBoolConverter}}" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>

                <Button Name="ButtonSelect" IsEnabled="False" Grid.Column="1" Content="{DynamicResource LOCSelect}" VerticalAlignment="Center" Click="ButtonSelect_Click" />
                <Button Name="ButtonSelectAll" IsEnabled="False" Grid.Column="3" Content="{DynamicResource LOCSelectAll}" VerticalAlignment="Center" Click="ButtonSelectAll_Click" />
                <Button Name="ButtonCancel" Grid.Column="5" Content="{DynamicResource LOCCancelLabel}" VerticalAlignment="Center" Click="ButtonCancel_Click" />
            </Grid>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0"
                     Name="PART_SearchList"
                     SelectionChanged="PART_SearchList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <controls2:TextBlockTrimmed Margin="0,2" Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Label Content="{DynamicResource LOCCommonTotalFound}" />
                    <Label Margin="8,0,0,0" Name="PART_TotalFound" />
                </StackPanel>

                <Grid Name="PART_GridElementContener" Grid.Row="2">
                    <ListBox Name="PART_ElementList"
                             SelectionMode="Multiple"
                             SelectionChanged="PART_ElementList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             BorderThickness="0"
                             Width="{Binding ElementName=PART_GridElementContener, Path=ActualWidth}"
                             Height="{Binding ElementName=PART_GridElementContener, Path=ActualHeight}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="8" LastChildFill="True" ToolTip="{Binding Url}">
                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                        <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                                                   Text="{Binding DisplayName}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="{Binding DataContext.PreviewWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                                                   Text="{Binding MetadataDisplay}"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   Foreground="{DynamicResource TextBrushDarker}"
                                                   Margin="0,4,0,0"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   Visibility="{Binding MetadataDisplay, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                                    </StackPanel>
                                    <Grid Width="{Binding DataContext.PreviewWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          Height="{Binding DataContext.PreviewHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Border Background="{DynamicResource NormalBrush}"
                                                Opacity="0.3"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                BorderBrush="{DynamicResource NormalBorderBrush}"
                                                BorderThickness="{DynamicResource ControlBorderThickness}"
                                                IsHitTestVisible="False"
                                                Visibility="{Binding IsLoading, ElementName=PART_ItemThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <controls1:ImageAsync x:Name="PART_ItemThumbnail"
                                                              Stretch="Uniform"
                                                              Source="{Binding Url}"
                                                              Width="{Binding DataContext.PreviewWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              Height="{Binding DataContext.PreviewHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        <Border IsHitTestVisible="False"
                                                Visibility="{Binding IsLoading, ElementName=PART_ItemThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                                                       Text="{DynamicResource LOCLoadingLabel}"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       Foreground="{DynamicResource TextBrushDarker}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
