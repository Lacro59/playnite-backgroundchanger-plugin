<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- MainView -->

    <sys:String x:Key="LOCBc">Сменщик фонов</sys:String>
    
    <sys:String x:Key="LOCBcManageBackground">Manage background images</sys:String>
    <sys:String x:Key="LOCBcManageCover">Manage cover images</sys:String>

    <!-- BackgroundChangerSettingsView -->

    <sys:String x:Key="LOCBcSteamGridDbApiKey">SteamGridDB api key</sys:String>
    
    <sys:String x:Key="LOCBcEnableBackgroundImage">Display the plugin background image</sys:String>
    <sys:String x:Key="LOCBcEnableCoverImage">Display the plugin cover image</sys:String>

    <sys:String x:Key="LOCBcBackgroundSameSettings">Используется та же настройка для фона игры плагина, что и для фона темы</sys:String>
    
    <sys:String x:Key="LOCBcEnableRandomSelect">Enable random selection</sys:String>
    <sys:String x:Key="LOCBcRandomOnStart">Только при запуске Playnite</sys:String>
    <sys:String x:Key="LOCBcRandomOnSelect">При выборе игры</sys:String>
    <sys:String x:Key="LOCBcEnableAutoChanger">Включить автоматическое изменение</sys:String>
    <sys:String x:Key="LOCBcTimeInterval">Временной интервал</sys:String>
    <sys:String x:Key="LOCBcSeconds">секунд</sys:String>

    <sys:String x:Key="LOCBcEnableImageAnimatedBackground">Включить анимированный фон</sys:String>
    <sys:String x:Key="LOCBcEnableImageAnimatedCover">Enable animated cover</sys:String>
    
    <sys:String x:Key="LOCBcEnableVideoDelay">Enable video delay</sys:String>
    <sys:String x:Key="LOCBcVideoDelayToolTip">Используйте этот параметр, если вы хотите перед видео отобразить дефолтное изображение.</sys:String>

    <!-- ImagesManagerView -->

    <sys:String x:Key="LOCBcSteamGridDbSelect">Выбрать из SteamGridDB</sys:String>
    <sys:String x:Key="LOCBcGoogleImageSelect">Выбрать из Google Image</sys:String>
    <sys:String x:Key="LOCBcAddFromUrl">Добавить из URL</sys:String>
    <sys:String x:Key="LOCBcAddFromUrlDescription">Введите URL к изображению</sys:String>
    <sys:String x:Key="LOCBcFfmpegFile">ffmpeg файл</sys:String>
    <sys:String x:Key="LOCBcWebpinfoFile">webpinfo файл</sys:String>

    <sys:String x:Key="LOCBcFfmpegNotFound">FFmpeg не найден</sys:String>
    <sys:String x:Key="LOCBcFTooltTipConvert">Convert to mp4 (performance improved)</sys:String>

    <sys:String x:Key="LOCBcInvalidUrlFormat">Неверный формат URL!</sys:String>

</ResourceDictionary>
