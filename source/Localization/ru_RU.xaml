<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- MainView -->

    <sys:String x:Key="LOCBc">BackgroundChanger</sys:String>
    
    <sys:String x:Key="LOCBcManageBackground">Управление фоновыми изображениями</sys:String>
    <sys:String x:Key="LOCBcManageCover">Управление обложками</sys:String>
    <sys:String x:Key="LOCBcManageIcon">Управление иконками</sys:String>

    <!-- BackgroundChangerSettingsView -->

    <sys:String x:Key="LOCBcSteamGridDbApiKey">API ключ SteamGridDB</sys:String>
    
    <sys:String x:Key="LOCBcEnableBackgroundImage">Отображать фоновое изображение плагина</sys:String>
    <sys:String x:Key="LOCBcEnableCoverImage">Отображать изображение обложки плагина</sys:String>
    <sys:String x:Key="LOCBcEnableIconImage">Отображать иконку плагина</sys:String>

    <sys:String x:Key="LOCBcBackgroundSameSettings">Используется тот же параметр для фона игры плагина, чем фон темы *</sys:String>

    <sys:String x:Key="LOCBcEnableRandomSelect">Включить случайный выбор</sys:String>
    <sys:String x:Key="LOCBcSelectionMode">Режим выбора</sys:String>
    <sys:String x:Key="LOCBcModeDefault">Избранное, если установлено, иначе по умолчанию - из Playnite</sys:String>
    <sys:String x:Key="LOCBcRandomOnStart">Only on Playnite start</sys:String>
    <sys:String x:Key="LOCBcRandomOnSelect">On game selection</sys:String>
    <sys:String x:Key="LOCBcEnableAutoChanger">Включить автоматическое изменение</sys:String>
    <sys:String x:Key="LOCBcTimerRandomOrder">Случайный порядок</sys:String>
    <sys:String x:Key="LOCBcTimerRandomOrderToolTip">Когда включено, элементы перемешиваются один раз и отображаются без повторов до тех пор, пока не будет исчерпан весь набор, после чего перемешиваются снова. При отключении этой функции элементы отображаются в порядке следования в списке.</sys:String>
    <sys:String x:Key="LOCBcTimeInterval">Временной интервал</sys:String>
    <sys:String x:Key="LOCBcSeconds">секунд(ы)</sys:String>

    <sys:String x:Key="LOCBcEnableVideoDelay">Включить задержку видео</sys:String>
    <sys:String x:Key="LOCBcVideoDelayToolTip">Используйте этот параметр, если вы хотите перед видео отобразить дефолтное изображение.</sys:String>
    <sys:String x:Key="LOCBcEnableRandomVideoStartPoint">Случайная точка старта видео</sys:String>
    <sys:String x:Key="LOCBcRandomVideoStartPointToolTip">Когда включено, воспроизведение видео начинается со случайной временной метки только при первом воспроизведении. Циклическое воспроизведение сохраняет непрерывность (без повторной рандомизации). По умолчанию отключено.</sys:String>

    <!-- ImagesManagerView -->

    <sys:String x:Key="LOCBcSteamSelect">Выбрать из Steam</sys:String>
    <sys:String x:Key="LOCBcSteamGet">Получить из Steam</sys:String>
    <sys:String x:Key="LOCBcSteamNoAppId">Не удалось найти Steam App ID для этой игры.</sys:String>
    <sys:String x:Key="LOCBcSteamNoAssets">Для этой игры не найдено официальных медиа Steam.</sys:String>
    <sys:String x:Key="LOCBcSteamGridDbSelect">Выбрать из SteamGridDB</sys:String>
    <sys:String x:Key="LOCBcSteamGridDbAnimated">Анимированный</sys:String>
    <sys:String x:Key="LOCBcSteamGridDbMimes">MIME типы</sys:String>
    <sys:String x:Key="LOCBcSteamGridDbApiKeyMissingNotification">В настройках плагина укажите API-ключ SteamGridDB для поиска и загрузки изображений и прочих медиа.</sys:String>
    <sys:String x:Key="LOCBcSteamGridDbUnauthorizedNotification">SteamGridDB отклонил API-ключ (ошибка 401 Unauthorized). Проверьте ключ в настройках плагина (недействителен, просрочен или отозван).</sys:String>
    <sys:String x:Key="LOCBcSteamGridDbForbiddenNotification">SteamGridDB отказал в доступе к этому ресурсу (ошибка 403 Forbidden). Возможно, ваш API-ключ не обладает необходимыми правами доступа.</sys:String>
    <sys:String x:Key="LOCBcSteamGridDbRateLimitNotification">Достигнут лимит запросов к SteamGridDB (429). Подождите немного и повторите попытку.</sys:String>
    <sys:String x:Key="LOCBcSteamGridDbParseErrorNotification">SteamGridDB вернул неожиданный ответ. Попробуйте еще раз или проверьте ваш API-ключ в настройках плагина.</sys:String>
    <sys:String x:Key="LOCBcSteamGridDbGenericErrorNotification">Не удалось выполнить запрос к SteamGridDB. Смотрите extensions.log для деталей.</sys:String>
    <sys:String x:Key="LOCBcGoogleImageSelect">Выбрать из Google Image</sys:String>
    <sys:String x:Key="LOCBcAddFromUrl">Добавить из URL</sys:String>
    <sys:String x:Key="LOCBcAddFromUrlDescription">Введите URL к изображению</sys:String>
    <sys:String x:Key="LOCBcFfmpegFile">ffmpeg файл</sys:String>
    <sys:String x:Key="LOCBcFfprobeFile">ffprobe файл</sys:String>
    <sys:String x:Key="LOCBcFfmpegFileDescription">Необходимо для импорта анимированных медиа файлов (WebP, WebM, APNG, GIF). Настройте FFmpeg и ffprobe (обычно находятся в одной папке). Файлы автоматически конвертируются в MP4 при импорте и запуске.</sys:String>

    <sys:String x:Key="LOCBcMediaConversionSection">Преобразование медиа</sys:String>
    <sys:String x:Key="LOCBcMediaConversionDefaultsCrf">CRF по умолчанию (качество)</sys:String>
    <sys:String x:Key="LOCBcMediaConversionCrf">CRF (0 = использовать по умолчанию)</sys:String>
    <sys:String x:Key="LOCBcMediaConversionCrfToolTip">Фактор постоянного качества H.264 (CRF, от 0 до 51). Меньшие значения повышают качество, но увеличивают размер файлов. Установите 0, чтобы использовать CRF по умолчанию, указанный выше.</sys:String>
    <sys:String x:Key="LOCBcMediaConversionCrfDescription">CRF определяет баланс между качеством MP4 и размером файла: меньшее значение улучшает качество изображения (увеличивая файл), а большее — уменьшает размер файла (снижая качество). Значение 23 — хорошая отправная точка для большинства пользователей.</sys:String>
    <sys:String x:Key="LOCBcMediaConversionAlphaNote">На выходе используется формат H.264 yuv420p, не поддерживающий прозрачность. Это приемлемо для большинства анимированных фонов и обложек, так как они редко используют альфа-канал.</sys:String>
    <sys:String x:Key="LOCBcMediaConversionAnimatedWebp">Анимированный WebP</sys:String>
    <sys:String x:Key="LOCBcMediaConversionWebm">WebM</sys:String>
    <sys:String x:Key="LOCBcMediaConversionApng">Анимированный PNG (APNG)</sys:String>
    <sys:String x:Key="LOCBcMediaConversionGif">Анимированный GIF</sys:String>
    <sys:String x:Key="LOCBcMediaConversionUseAutoFramerate">Использовать скорость анимации источника</sys:String>
    <sys:String x:Key="LOCBcMediaConversionFixedFramerate">Фиксированная частота кадров (fps)</sys:String>
    <sys:String x:Key="LOCBcMediaConversionForceReencode">Всегда перекодировать в H.264</sys:String>
    <sys:String x:Key="LOCBcMediaConversionForceReencodeToolTip">Если отключено, FFmpeg попытается скопировать видеопоток без перекодирования, если файл WebM уже совместим с H.264.</sys:String>
    <sys:String x:Key="LOCBcMediaConversionCrfInvalid">Значение CRF для конвертации медиа должно быть 0 (наследовать дефолтное) или от 0 до 51. Значение CRF по умолчанию должно быть в диапазоне от 0 до 51.</sys:String>
    <sys:String x:Key="LOCBcMediaConversionFramerateInvalid">Частота кадров при конвертации медиа должна быть от 1 до 120 кадров/с (fps).</sys:String>

    <sys:String x:Key="LOCBcFfmpegNotFound">Ffmpeg not found</sys:String>
    <sys:String x:Key="LOCBcFfmpegOutdated">Версия ffmpeg или ffprobe слишком устарела</sys:String>
    <sys:String x:Key="LOCBcFfmpegPathNotConfigured">не настроено</sys:String>
    <sys:String x:Key="LOCBcFfmpegStartupNotification">FFmpeg не настроен или исполняемый файл не найден в &quot;{0}&quot;. Анимированные медиа файлы не могут быть импортированы или преобразованы до тех пор, пока FFmpeg не будет настроен в настройках плагина.</sys:String>
    <sys:String x:Key="LOCBcMediaToolkitStartupNotification">FFmpeg и ffprobe должны быть настроены для импорта и преобразования анимированных медиа. FFmpeg: {0}. ffprobe: {1}.</sys:String>
    <sys:String x:Key="LOCBcMediaToolkitOutdatedNotification">Импорт и преобразование анимированных медиа файлов требуют FFmpeg {0} или новее (обнаружено: {1}). Обновите ваш FFmpeg и ffprobe в настройках плагина.</sys:String>
    <sys:String x:Key="LOCBcFfmpegConversionFailed">Преобразование в MP4 не удалось. Обнаружен набор инструментов: {0}. Анимированный WebP требует FFmpeg {1} или новее с поддержкой анимированного декодирования libwebp.</sys:String>
    <sys:String x:Key="LOCBcInvalidUrlFormat">Неверный формат URL!</sys:String>

    <!-- Bulk media download (#25) -->

    <sys:String x:Key="LOCBcBulkDownloadTitle">Массовая загрузка медиа</sys:String>
    <sys:String x:Key="LOCBcBulkDownloadMenu">Массовая загрузка медиа...</sys:String>
    <sys:String x:Key="LOCBcBulkNoGamesSelected">Нет игр, соответствующих выбранным фильтрам.</sys:String>
    <sys:String x:Key="LOCBcBulkSources">Источники</sys:String>
    <sys:String x:Key="LOCBcBulkSourceSteam">Официальный Steam</sys:String>
    <sys:String x:Key="LOCBcBulkSourceSteamGridDb">SteamGridDB</sys:String>
    <sys:String x:Key="LOCBcBulkMediaKinds">Типы медиа</sys:String>
    <sys:String x:Key="LOCBcBulkOnlyMissing">Не обрабатывать уже имеющиеся медиафайлы плагина для каждого типа (Фон/Обложка/Иконка)</sys:String>
    <sys:String x:Key="LOCBcBulkOnlyGamesWithoutData">Только игры без изображений плагина</sys:String>
    <sys:String x:Key="LOCBcBulkQuantity">Количество (общее по каждому типу медиа)</sys:String>
    <sys:String x:Key="LOCBcBulkDownloadAll">Скачать всё</sys:String>
    <sys:String x:Key="LOCBcBulkFuzzyThreshold">Порог соответствия имени</sys:String>
    <sys:String x:Key="LOCBcBulkPromptLowFuzzy">Запрашивать, когда количество совпадений ниже порогового значения</sys:String>
    <sys:String x:Key="LOCBcBulkAllowAnimated">Разрешить анимированные ресурсы из SteamGridDB</sys:String>
    <sys:String x:Key="LOCBcBulkPickMode">Выбор SteamGridDB</sys:String>
    <sys:String x:Key="LOCBcBulkPickRandom">Случайный</sys:String>
    <sys:String x:Key="LOCBcBulkPickBestScore">Лучший результат</sys:String>
    <sys:String x:Key="LOCBcBulkPickBestVotes">Лучшие по голосам</sys:String>
    <sys:String x:Key="LOCBcBulkPickNewest">Новейшие (по id)</sys:String>
    <sys:String x:Key="LOCBcBulkSteamGridFilters">Фильтры SteamGridDB</sys:String>
    <sys:String x:Key="LOCBcBulkSaveOptions">Параметры сохранения</sys:String>
    <sys:String x:Key="LOCBcBulkOptionsSaved">Параметры массовой загрузки были сохранены.</sys:String>
    <sys:String x:Key="LOCBcBulkOptionsInvalid">Выберите хотя бы один источник и один тип медиа.</sys:String>
    <sys:String x:Key="LOCBcBulkFuzzyPrompt">Выберите соответствующую игру из SteamGridDB</sys:String>
    <sys:String x:Key="LOCBcBulkDownloadSummary">Импортировано: {0} — Пропущено: {1} — Ошибки: {2}</sys:String>
    <sys:String x:Key="LOCBcBulkDownloadCancelled">Загрузка была отменена.</sys:String>

</ResourceDictionary>
