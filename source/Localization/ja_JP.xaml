<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- MainView -->

    <sys:String x:Key="LOCBc">BackgroundChanger</sys:String>
    
    <sys:String x:Key="LOCBcManageBackground">Manage background images</sys:String>
    <sys:String x:Key="LOCBcManageCover">カバー画像の管理</sys:String>

    <!-- BackgroundChangerSettingsView -->

    <sys:String x:Key="LOCBcSteamGridDbApiKey">SteamGridDB API キー</sys:String>
    
    <sys:String x:Key="LOCBcEnableBackgroundImage">プラグインの背景画像を表示</sys:String>
    <sys:String x:Key="LOCBcEnableCoverImage">プラグインのカバー画像を表示</sys:String>

    <sys:String x:Key="LOCBcBackgroundSameSettings">プラグインのゲーム背景をテーマ背景と同じ設定にした 。*</sys:String>
    
    <sys:String x:Key="LOCBcEnableRandomSelect">ランダム選択を有効にする</sys:String>
    <sys:String x:Key="LOCBcRandomOnStart">Only on Playnite start</sys:String>
    <sys:String x:Key="LOCBcRandomOnSelect">On game selection</sys:String>
    <sys:String x:Key="LOCBcEnableAutoChanger">Enable automatic change</sys:String>
    <sys:String x:Key="LOCBcTimeInterval">Time interval</sys:String>
    <sys:String x:Key="LOCBcSeconds">seconds</sys:String>

    <sys:String x:Key="LOCBcEnableImageAnimatedBackground">アニメーション背景を有効にする</sys:String>
    <sys:String x:Key="LOCBcEnableImageAnimatedCover">アニメーションカバーを有効にする</sys:String>
    
    <sys:String x:Key="LOCBcEnableVideoDelay">ビデオの遅延を有効にする</sys:String>
    <sys:String x:Key="LOCBcVideoDelayToolTip">ビデオの前に既定の画像を表示する場合は、このオプションを使用します。</sys:String>

    <!-- ImagesManagerView -->

    <sys:String x:Key="LOCBcSteamGridDbSelect">Select from SteamGridDB</sys:String>
    <sys:String x:Key="LOCBcGoogleImageSelect">Select from Google Image</sys:String>
    <sys:String x:Key="LOCBcAddFromUrl">Add from url</sys:String>
    <sys:String x:Key="LOCBcAddFromUrlDescription">Enter the url to the image</sys:String>
    <sys:String x:Key="LOCBcFfmpegFile">ffmpeg file</sys:String>
    <sys:String x:Key="LOCBcWebpinfoFile">webpinfo file</sys:String>

    <sys:String x:Key="LOCBcFfmpegNotFound">Ffmpeg not found</sys:String>
    <sys:String x:Key="LOCBcFTooltTipConvert">Convert to mp4 (performance improved)</sys:String>

    <sys:String x:Key="LOCBcInvalidUrlFormat">Invalid Url Format!</sys:String>

</ResourceDictionary>
