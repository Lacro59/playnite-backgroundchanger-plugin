<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- MainView -->

    <sys:String x:Key="LOCBc">Modificateur d'arrière-plan</sys:String>
    
    <sys:String x:Key="LOCBcManageBackground">Gérer les images de fond</sys:String>
    <sys:String x:Key="LOCBcManageCover">Gérer les pochettes</sys:String>

    <!-- BackgroundChangerSettingsView -->

    <sys:String x:Key="LOCBcSteamGridDbApiKey">Clé API SteamGridDB</sys:String>
    
    <sys:String x:Key="LOCBcEnableBackgroundImage">Affiche l'image de fond du plugin</sys:String>
    <sys:String x:Key="LOCBcEnableCoverImage">Affiche la pochette du plugin</sys:String>

    <sys:String x:Key="LOCBcBackgroundSameSettings">Utiliser le même paramètre pour l'arrière-plan du jeu de plugin que l'arrière-plan du thème *</sys:String>
    
    <sys:String x:Key="LOCBcEnableRandomSelect">Activer la sélection aléatoire</sys:String>
    <sys:String x:Key="LOCBcRandomOnStart">Seulement au démarrage de Playnite</sys:String>
    <sys:String x:Key="LOCBcRandomOnSelect">À la sélection du jeu</sys:String>
    <sys:String x:Key="LOCBcEnableAutoChanger">Activer le changement automatique</sys:String>
    <sys:String x:Key="LOCBcTimeInterval">Intervalle de temps</sys:String>
    <sys:String x:Key="LOCBcSeconds">secondes</sys:String>

    <sys:String x:Key="LOCBcEnableImageAnimatedBackground">Activer le fond animé</sys:String>
    <sys:String x:Key="LOCBcEnableImageAnimatedCover">Activer la pochette animée</sys:String>
    
    <sys:String x:Key="LOCBcEnableVideoDelay">Activer le retard vidéo</sys:String>
    <sys:String x:Key="LOCBcVideoDelayToolTip">Utilisez cette option si vous voulez afficher l'image par défaut avant une vidéo.</sys:String>

    <!-- ImagesManagerView -->

    <sys:String x:Key="LOCBcSteamGridDbSelect">Sélectionner depuis SteamGridDB</sys:String>
    <sys:String x:Key="LOCBcGoogleImageSelect">Sélectionner depuis Google Image</sys:String>
    <sys:String x:Key="LOCBcAddFromUrl">Ajouter depuis une url</sys:String>
    <sys:String x:Key="LOCBcAddFromUrlDescription">Saisir l'url de l'image</sys:String>
    <sys:String x:Key="LOCBcFfmpegFile">fichier ffmpeg</sys:String>
    <sys:String x:Key="LOCBcFfmpegFileDescription">Nécessaire pour importer des médias animés (WebP, WebM, APNG, GIF). Les fichiers sont automatiquement convertis en MP4 à l'import et au démarrage.</sys:String>
    <sys:String x:Key="LOCBcWebpinfoFile">fichier webpinfo</sys:String>

    <sys:String x:Key="LOCBcMediaConversionSection">Conversion des médias</sys:String>
    <sys:String x:Key="LOCBcMediaConversionDefaultsCrf">CRF par défaut (qualité)</sys:String>
    <sys:String x:Key="LOCBcMediaConversionCrf">CRF (0 = utiliser la valeur par défaut)</sys:String>
    <sys:String x:Key="LOCBcMediaConversionCrfToolTip">Facteur de débit constant H.264 (0–51). Une valeur basse améliore la qualité et augmente la taille du fichier. Mettez 0 pour utiliser le CRF par défaut ci-dessus.</sys:String>
    <sys:String x:Key="LOCBcMediaConversionCrfDescription">Le CRF règle le compromis entre qualité et taille du MP4 : une valeur plus basse améliore l'image (fichier plus lourd), une valeur plus haute réduit la taille (qualité moindre). 23 convient en général.</sys:String>
    <sys:String x:Key="LOCBcMediaConversionAnimatedWebp">WebP animé</sys:String>
    <sys:String x:Key="LOCBcMediaConversionWebm">WebM</sys:String>
    <sys:String x:Key="LOCBcMediaConversionApng">PNG animé (APNG)</sys:String>
    <sys:String x:Key="LOCBcMediaConversionGif">GIF animé</sys:String>
    <sys:String x:Key="LOCBcMediaConversionUseAutoFramerate">Utiliser le rythme d'images de la source</sys:String>
    <sys:String x:Key="LOCBcMediaConversionFixedFramerate">Images par seconde (fps) fixe</sys:String>
    <sys:String x:Key="LOCBcMediaConversionForceReencode">Toujours réencoder en H.264</sys:String>
    <sys:String x:Key="LOCBcMediaConversionForceReencodeToolTip">Si désactivé, FFmpeg tente de copier le flux vidéo lorsque le WebM est déjà compatible H.264.</sys:String>
    <sys:String x:Key="LOCBcMediaConversionCrfInvalid">Le CRF doit être 0 (hériter du défaut) ou compris entre 0 et 51. Le CRF par défaut doit être entre 0 et 51.</sys:String>
    <sys:String x:Key="LOCBcMediaConversionFramerateInvalid">Le nombre d'images par seconde doit être compris entre 1 et 120.</sys:String>

    <sys:String x:Key="LOCBcFfmpegNotFound">FFmpeg non trouvé</sys:String>
    <sys:String x:Key="LOCBcFTooltTipConvert">Convertir en mp4 (meilleures performances)</sys:String>

    <sys:String x:Key="LOCBcInvalidUrlFormat">Format d'url invalide !</sys:String>

</ResourceDictionary>
