    <sys:String x:Key="LOCBcBulkSteamGridFilters">Filtres SteamGridDB</sys:String>
    <sys:String x:Key="LOCBcBulkSaveOptions">Options d'enregistrement</sys:String>
    <sys:String x:Key="LOCBcBulkOptionsSaved">Les options de téléchargement groupé ont été enregistrées.</sys:String>
    <sys:String x:Key="LOCBcBulkOptionsInvalid">Sélectionnez au moins une source et un type de média.</sys:String>
    <sys:String x:Key="LOCBcBulkFuzzyPrompt">Sélectionnez le jeu SteamGridDB correspondant</sys:String>
    <sys:String x:Key="LOCBcBulkDownloadSummary">Importés : {0} — Ignorés : {1} — Erreurs : {2}</sys:String>
    <sys:String x:Key="LOCBcBulkDownloadCancelled">Le téléchargement a été annulé.</sys:String>

</ResourceDictionary>
