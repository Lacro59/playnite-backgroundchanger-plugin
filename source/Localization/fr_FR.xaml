    <sys:String x:Key="LOCBcBulkDownloadAll">Tout télécharger</sys:String>
    <sys:String x:Key="LOCBcBulkFuzzyThreshold">Seuil de correspondance du nom</sys:String>
    <sys:String x:Key="LOCBcBulkPromptLowFuzzy">Demander confirmation si la correspondance est sous le seuil</sys:String>
    <sys:String x:Key="LOCBcBulkAllowAnimated">Autoriser les assets animés SteamGridDB</sys:String>
    <sys:String x:Key="LOCBcBulkPickMode">Sélection SteamGridDB</sys:String>
    <sys:String x:Key="LOCBcBulkPickRandom">Aléatoire</sys:String>
    <sys:String x:Key="LOCBcBulkPickBestScore">Meilleur score</sys:String>
    <sys:String x:Key="LOCBcBulkPickBestVotes">Meilleurs votes positifs</sys:String>
